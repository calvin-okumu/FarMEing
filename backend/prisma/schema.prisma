// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  password  String
  role      String   @default("OWNER") // OWNER, MANAGER, VIEWER
  currency  String   @default("TZS")
  locale    String   @default("sw-TZ")
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  FarmProject[]
  employees Employee[]
  seasons   Season[]
  payees    Payee[]
  projectAccess ProjectAccess[]
}

model ProjectAccess {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  userName  String?
  userPhone String?
  role      String   // OWNER, MANAGER, VIEWER

  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  project   FarmProject @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model Payee {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String?
  email     String?
  address   String?
  category  String?  // e.g. Supplier, Contractor, Individual
  notes     String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  expenses  Expense[]
  inventoryItems InventoryItem[]
}

model Season {
  id        String      @id @default(uuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime?
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  projects  FarmProject[]
}

model FarmProject {
  id            String       @id @default(uuid())
  userId        String
  userName      String?
  userPhone     String?
  seasonId      String?
  name          String
  crop          String
  cropVariety   String?
  landSize      Float
  landUnit      String       @default("acres")
  startDate     DateTime
  endDate       DateTime?
  expectedYield Float?       @default(0)
  status        String       @default("ACTIVE") // PLANNING, ACTIVE, HARVESTED, CLOSED
  notes         String?
  contractUrl   String?
  isDeleted     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  season        Season?      @relation(fields: [seasonId], references: [id])
  blocks        ProjectBlock[]
  budgetItems   BudgetItem[]
  expenses      Expense[]
  workEntries   WorkEntry[]
  harvests      Harvest[]
  sales         Sale[]
  inventoryItems InventoryItem[]
  employees     EmployeeProject[]
  projectAccess ProjectAccess[]
  invitations   ProjectInvitation[]
}

model ProjectInvitation {
  id          String      @id @default(uuid())
  projectId   String
  role        String      // MANAGER, VIEWER
  inviteCode  String      @unique
  expiresAt   DateTime
  isUsed      Boolean     @default(false)
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     FarmProject @relation(fields: [projectId], references: [id])
}

model ProjectBlock {
  id            String      @id @default(uuid())
  projectId     String
  name          String      // e.g. Block A, Section 1
  landSize      Float?
  landUnit      String?
  crop          String?
  cropVariety   String?
  expectedYield Float?
  isDeleted     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       FarmProject @relation(fields: [projectId], references: [id])
  budgetItems   BudgetItem[]
  expenses      Expense[]
  workEntries   WorkEntry[]
  harvests      Harvest[]
  sales         Sale[]
}

model BudgetItem {
  id        String      @id @default(uuid())
  projectId String
  blockId   String?
  category  String
  name      String
  quantity  Float
  unit      String
  unitPrice Float
  total     Float
  notes     String?
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   FarmProject @relation(fields: [projectId], references: [id])
  block     ProjectBlock? @relation(fields: [blockId], references: [id])
}

model Expense {
  id          String      @id @default(uuid())
  projectId   String
  blockId     String?
  category    String
  expenseType String      @default("OPEX") // CAPEX, OPEX
  amount      Float
  date        DateTime
  isRecurring Boolean     @default(false)
  frequency   String?     // DAILY, WEEKLY, MONTHLY
  note        String?
  receiptUrl  String?
  payee       String?
  payeeId     String?
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     FarmProject @relation(fields: [projectId], references: [id])
  block       ProjectBlock? @relation(fields: [blockId], references: [id])
  payeeRecord Payee?       @relation(fields: [payeeId], references: [id])
}


model Employee {
  id          String       @id @default(uuid())
  userId      String
  name        String
  phone       String?
  role        String?
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  workEntries WorkEntry[]
  payments    Payment[]
  assignments EmployeeProject[]
}

model EmployeeProject {
  id        String      @id @default(uuid())
  employeeId String
  projectId String
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  employee  Employee    @relation(fields: [employeeId], references: [id])
  project   FarmProject @relation(fields: [projectId], references: [id])

  @@unique([employeeId, projectId])
}

model WorkEntry {
  id          String      @id @default(uuid())
  projectId   String
  blockId     String?
  employeeId  String
  activity    String
  date        DateTime
  daysWorked  Float
  ratePerDay  Float
  totalCost   Float
  hoursWorked Float?
  imageUrl    String?
  locationLat Float?
  locationLng Float?
  status      String      @default("PENDING") // PENDING, APPROVED, REJECTED
  isRecurring Boolean     @default(false)
  frequency   String?     // DAILY, WEEKLY, MONTHLY
  notes       String?
  isPaid      Boolean     @default(false)
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     FarmProject @relation(fields: [projectId], references: [id])
  block       ProjectBlock? @relation(fields: [blockId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])
}

model Payment {
  id         String   @id @default(uuid())
  employeeId String
  amount     Float
  date       DateTime
  note       String?
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Harvest {
  id             String         @id @default(uuid())
  projectId      String
  blockId        String?
  crop           String
  date           DateTime
  weight         Float
  rejectedWeight Float?
  rejectedReason String?
  unit           String         @default("kg")
  quality        String?
  notes          String?
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  project        FarmProject    @relation(fields: [projectId], references: [id])
  block          ProjectBlock?  @relation(fields: [blockId], references: [id])
  saleHarvests   SaleHarvest[]
}


model Sale {
  id             String         @id @default(uuid())
  projectId      String
  blockId        String?
  date           DateTime
  customer       String?
  weightSold     Float
  unitPrice      Float
  totalAmount    Float
  paymentStatus  String?
  balanceDue     Float?
  receiptUrl     String?
  notes          String?
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  project        FarmProject    @relation(fields: [projectId], references: [id])
  block          ProjectBlock?  @relation(fields: [blockId], references: [id])
  salePayments   SalePayment[]
  saleHarvests   SaleHarvest[]
}

model SaleHarvest {
  id           String   @id @default(uuid())
  saleId       String
  harvestId    String
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sale         Sale     @relation(fields: [saleId], references: [id])
  harvest      Harvest  @relation(fields: [harvestId], references: [id])

  @@unique([saleId, harvestId])
}

model SalePayment {
  id           String   @id @default(uuid())
  saleId       String
  amount       Float
  date         DateTime
  note         String?
  syncStatus   String?
  lastSyncedAt DateTime?
  lastError    String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sale         Sale     @relation(fields: [saleId], references: [id])
}

model InventoryItem {
  id        String   @id @default(uuid())
  projectId String
  name      String
  category  String
  quantity  Float
  unit      String
  unitCost  Float
  totalCost Float
  usedQty   Float    @default(0)
  notes     String?
  payee     String?
  payeeId   String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   FarmProject @relation(fields: [projectId], references: [id])
  payeeRecord Payee?    @relation(fields: [payeeId], references: [id])
}
