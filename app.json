{
  "expo": {
    "entryPoint": "./frontend/App.js",
    "name": "FarmTrack",
    "slug": "farmtrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./frontend/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmtrack.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./frontend/assets/android-icon-foreground.png",
        "backgroundImage": "./frontend/assets/android-icon-background.png",
        "monochromeImage": "./frontend/assets/android-icon-monochrome.png"
      },
      "package": "com.farmtrack.app"
    },
    "web": {
      "favicon": "./frontend/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
